#!/bin/bash
# wt-create <branch> [--base <ref>] [--repo <main-checkout>] [--dir <name>]
#
# Creates a git worktree where the repo's tooling expects it and performs the
# setup that 35 papercut entries rediscovered by hand:
#   location   <main-parent>/<main-name>-worktrees/<dir>   (never /tmp, never scratchpad)
#   makefiles  if the Makefile includes ../solution, symlink solution and
#              node_modules next to the worktrees so `make` resolves
#   env files  copy gitignored root .env* and supabase/functions/.env (no overwrite)
#   repo hook  run <main>/.claude/worktree-setup.sh <worktree> <main> when present
# Last stdout line: WORKTREE <path>. Exit 64 on refusal, 1 on git failure.

set -o pipefail
BRANCH=""; BASE=""; MAIN=""; DIR=""; BASE_GIVEN=0
while [ $# -gt 0 ]; do
    case "$1" in
        --base) BASE="$2"; BASE_GIVEN=1; shift 2 ;;
        --repo) MAIN="$2"; shift 2 ;;
        --dir) DIR="$2"; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        -*) echo "wt-create: unknown flag $1" >&2; exit 64 ;;
        *) BRANCH="$1"; shift ;;
    esac
done
[ -z "$BRANCH" ] && { echo "usage: wt-create <branch> [--base <ref>] [--repo <main-checkout>] [--dir <name>]" >&2; exit 64; }
[ -z "$MAIN" ] && MAIN=$(git rev-parse --show-toplevel 2>/dev/null)
[ -z "$MAIN" ] && { echo "wt-create: not in a git checkout; pass --repo" >&2; exit 64; }
# From inside a linked worktree, --show-toplevel is the worktree; the main checkout owns the common dir.
COMMON=$(git -C "$MAIN" rev-parse --git-common-dir 2>/dev/null) || { echo "wt-create: $MAIN is not a git checkout" >&2; exit 64; }
MAIN=$(cd "$MAIN" && cd "$COMMON" && cd .. && pwd -P)
case "$MAIN" in /tmp/*|/private/tmp/*|*/scratchpad/*)
    echo "wt-create: refusing: worktrees are never under /tmp or the scratchpad (Makefiles include ../solution, reboots wipe /tmp). Main checkout: $MAIN" >&2; exit 64 ;;
esac
[ -z "$DIR" ] && DIR=$(printf '%s' "$BRANCH" | tr '/' '-' | tr -c 'A-Za-z0-9._-\n' '-')
PARENT="$(dirname "$MAIN")/$(basename "$MAIN")-worktrees"
WT="$PARENT/$DIR"
[ -e "$WT" ] && { echo "wt-create: $WT already exists" >&2; exit 64; }
mkdir -p "$PARENT"

if [ -z "$BASE" ]; then
    BASE=$(git -C "$MAIN" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
    [ -z "$BASE" ] && BASE=$(git -C "$MAIN" rev-parse --abbrev-ref HEAD)
fi
if git -C "$MAIN" show-ref --verify -q "refs/heads/$BRANCH"; then
    echo "checking out existing local branch $BRANCH"
    git -C "$MAIN" worktree add "$WT" "$BRANCH" || exit 1
elif git -C "$MAIN" show-ref --verify -q "refs/remotes/origin/$BRANCH"; then
    # The PR case: the branch lives on origin. Never recreate it off base.
    if [ "$BASE_GIVEN" = 1 ]; then
        echo "wt-create: $BRANCH exists on origin; drop --base to check it out tracking origin/$BRANCH, or pick another branch name" >&2; exit 64
    fi
    echo "checking out origin/$BRANCH (tracking)"
    git -C "$MAIN" worktree add --track -b "$BRANCH" "$WT" "origin/$BRANCH" || exit 1
else
    echo "creating $BRANCH from $BASE"
    git -C "$MAIN" worktree add -b "$BRANCH" "$WT" "$BASE" || exit 1
fi

# Makefiles that include ../solution resolve relative to the checkout dir.
if grep -qs '\.\./solution' "$MAIN/Makefile" "$MAIN/makefile" 2>/dev/null; then
    [ -e "$PARENT/solution" ] || { ln -s "$(dirname "$MAIN")/solution" "$PARENT/solution"; echo "linked $PARENT/solution"; }
    [ -e "$PARENT/node_modules" ] || { ln -s "$MAIN/node_modules" "$PARENT/node_modules"; echo "linked $PARENT/node_modules"; }
fi

# Gitignored env files do not come with a worktree.
for f in "$MAIN"/.env "$MAIN"/.env.* "$MAIN"/supabase/functions/.env; do
    [ -f "$f" ] || continue
    rel=${f#"$MAIN"/}
    [ -e "$WT/$rel" ] && continue
    mkdir -p "$(dirname "$WT/$rel")"; cp "$f" "$WT/$rel"; echo "copied $rel"
done

if [ -f "$MAIN/.claude/worktree-setup.sh" ]; then
    echo "running .claude/worktree-setup.sh"
    bash "$MAIN/.claude/worktree-setup.sh" "$WT" "$MAIN" || echo "wt-create: worktree-setup.sh exited $? (continuing)" >&2
fi

[ -d "$WT/node_modules" ] || [ -L "$PARENT/node_modules" ] || echo "hint: no node_modules in the worktree; run the repo's install from inside $WT (not --ignore-scripts: it skips native builds like sharp/isolated-vm)"
echo "WORKTREE $WT"
