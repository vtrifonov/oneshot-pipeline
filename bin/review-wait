#!/bin/bash
# review-wait <pr> [--max SECONDS] [--interval SECONDS] [--repo owner/name]
#
# Blocks until the AI reviewer has DECIDED on the PR's current head, or CI fails.
# ci-wait can return when a configured review CHECK passes; that check is green even
# when the reviewer skipped on size, and it predates the approval decision by
# minutes. This script waits for the decision itself: the configured bot
# review whose body carries `<!-- ai-review:approval reviewed=<head sha> -->`.
#
#   exit 0  REVIEW DONE — prints head, decision state, approved|withheld,
#           skipReason from the run log (pr_too_large means nothing was
#           reviewed), unresolved thread count, and every non-approval review
#           the bot posted on this head (findings can live in a review BODY
#           with no thread — see pr-threads --reviews)
#   exit 1  a CI check failed or was cancelled (named on stdout)
#   exit 2  --max reached (default 240s; use bounded continuation and call again)
#
# No checks are excluded by default; CI_EXCLUDE_CHECKS explicitly configures non-gating checks.

set -o pipefail

PR=""; MAX=240; INTERVAL=30; REPO=""
while [ $# -gt 0 ]; do
    case "$1" in
        --max) MAX="$2"; shift 2 ;;
        --interval) INTERVAL="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
        *) PR="$1"; shift ;;
    esac
done
[ -z "$PR" ] && { echo "usage: review-wait <pr> [--max S] [--interval S] [--repo owner/name]" >&2; exit 64; }
# shellcheck source=lib/resolve-pr-repo.sh
. "$(dirname "$(readlink -f "$0")")/lib/resolve-pr-repo.sh"
REPO=$(resolve_pr_repo review-wait "$PR" "$REPO") || exit 64

BOT=${AI_REVIEW_BOT:-}
[ -n "$BOT" ] || { echo "review-wait: configure AI_REVIEW_BOT for a marker-compatible bot; otherwise use native review APIs" >&2; exit 64; }
EXCLUDE=${CI_EXCLUDE_CHECKS:-'^$'}

unresolved_count() { # paginated: GitHub caps reviewThreads at 100 per page and never warns
    local cursor="" after="" page n=0
    while :; do
        [ -n "$cursor" ] && after=", after: \"$cursor\""
        page=$(gh api graphql -f query="
        query { repository(owner: \"${REPO%/*}\", name: \"${REPO#*/}\") { pullRequest(number: $PR) {
          reviewThreads(first: 100$after) { pageInfo { hasNextPage endCursor } nodes { isResolved } } } } }" 2>/dev/null) || { echo "?"; return; }
        n=$(( n + $(printf '%s' "$page" | jq -r '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved==false)] | length') ))
        [ "$(printf '%s' "$page" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.hasNextPage')" = "true" ] || break
        cursor=$(printf '%s' "$page" | jq -r '.data.repository.pullRequest.reviewThreads.pageInfo.endCursor')
    done
    echo "$n"
}

skip_reason() { # <engine review body> -> skipReason value from the review JOB log (null = a real review happened), or "unknown"
    local run_id job_id v
    run_id=$(printf '%s' "$1" | grep -oE 'actions/runs/[0-9]+' | head -1 | grep -oE '[0-9]+')
    [ -z "$run_id" ] && { echo unknown; return; }
    # Only the review job's log, not the whole run (tens of MB, tens of seconds).
    job_id=$(gh run view "$run_id" --repo "$REPO" --json jobs --jq '.jobs[] | select(.name | test(env.AI_REVIEW_JOB // "review")) | .databaseId' 2>/dev/null | head -1)
    [ -z "$job_id" ] && { echo unknown; return; }
    # The result JSON is logged escaped: ...\"reviewedSha\":\"<sha>\",...,\"skipReason\":null}
    v=$(gh run view --repo "$REPO" --job "$job_id" --log 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
        | grep -E 'reviewedSha' | tail -1 | grep -oE 'skipReason[^,}]*' | sed -E 's/^skipReason//; s/[^A-Za-z0-9_ ]//g; s/^ +//')
    echo "${v:-unknown}"
}

start=$(date +%s); prev=""
while :; do
    head=$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid 2>/dev/null)
    raw=$(gh pr checks "$PR" --repo "$REPO" --json name,bucket 2>/dev/null)
    if [ -n "$raw" ] && [ "$raw" != "[]" ]; then
        failed=$(printf '%s' "$raw" | jq -r --arg ex "$EXCLUDE" '.[] | select(.name | test($ex) | not) | select(.bucket=="fail" or .bucket=="cancel") | .name')
        if [ -n "$failed" ]; then echo "FAILED head=$head:"; printf '%s\n' "$failed" | sed 's/^/  /'; exit 1; fi
        snap=$(printf '%s' "$raw" | jq -r --arg ex "$EXCLUDE" '[.[] | select(.name | test($ex) | not)] | group_by(.bucket) | map("\(.[0].bucket):\(length)") | join(" ")')
    else
        # A conflicting branch may have no check suite.
        mstate=$(gh pr view "$PR" --repo "$REPO" --json mergeable --jq .mergeable 2>/dev/null)
        if [ "$mstate" = "CONFLICTING" ]; then
            echo "CONFLICTING head=$head — no check suite is created for a conflicting branch, so there is nothing to wait for."
            echo "  Fix: resolve the PR base branch, merge its current head, verify, then push."
            exit 3
        fi
        snap="no checks reported yet"
    fi
    reviews=$(gh api "repos/$REPO/pulls/$PR/reviews" --paginate 2>/dev/null | jq -c --arg bot "$BOT" --arg head "$head" '.[] | select(.user.login==$bot and .commit_id==$head)')
    approval=$(printf '%s\n' "$reviews" | jq -c --arg head "$head" 'select(.body | test("ai-review:approval reviewed=" + $head))' | tail -1)
    state_line="head=${head:0:8} checks: $snap bot_reviews_on_head=$(printf '%s\n' "$reviews" | grep -c .)"
    if [ "$state_line" != "$prev" ]; then echo "[$(date +%H:%M:%S)] +$(( $(date +%s) - start ))s $state_line"; prev="$state_line"; fi

    if [ -n "$approval" ]; then
        decision=$(printf '%s' "$approval" | jq -r .state)
        # Only an APPROVED decision review is approval; any other wording of the decision is withheld.
        verdict=withheld; [ "$decision" = "APPROVED" ] && verdict=approved
        engine=$(printf '%s\n' "$reviews" | jq -r 'select(.body | test("ai-review:engine=")) | .body' | tail -1)
        reason=$(skip_reason "$engine")
        size_gate=0; [ "$verdict" = withheld ] && [ "$reason" = pr_too_large ] && size_gate=1
        # Context lines first; the machine-readable REVIEW DONE line is always the LAST line of output.
        printf '%s\n' "$reviews" | jq -r --arg head "$head" 'select(.body | test("ai-review:approval") | not) | "--- bot review \(.state) \(.submitted_at) (\(.body | gsub("<details>(.|\n)*?</details>"; "") | gsub("\n+"; " ") | .[0:400]))"'
        [ "$size_gate" = 1 ] && echo "SIZE GATE: withheld with skipReason=pr_too_large — nothing was reviewed; terminal (ping the owner), do not re-request"
        echo "REVIEW DONE head=$head decision=$decision approval=$verdict skipReason=$reason size_gate=$size_gate unresolved_threads=$(unresolved_count) reviewDecision=$(gh pr view "$PR" --repo "$REPO" --json reviewDecision --jq .reviewDecision 2>/dev/null)"
        exit 0
    fi
    if [ $(( $(date +%s) - start )) -ge "$MAX" ]; then echo "TIMEOUT after ${MAX}s head=$head — no approval decision yet; call review-wait again"; exit 2; fi
    sleep "$INTERVAL"
done
