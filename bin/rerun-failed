#!/bin/bash
# rerun-failed <pr> <head-sha> [--max SECONDS] [--interval SECONDS] [--repo owner/name]
#
# A flaky check gets a rerun, never a commit. Reruns the failed jobs of every
# failed/cancelled workflow run for <head-sha>, then waits — with its own pacing —
# until `gh pr checks` no longer reports a fail/cancel bucket for the PR, so the
# next review-wait does not read GitHub's stale fail state (it lingers for
# seconds to a minute after the rerun is accepted). Prints ONE last line:
#
#   RERUN DONE reruns=<run ids,> reset=confirmed|stale|nothing-to-rerun
#
#   exit 0  reset confirmed, or there was nothing failed to rerun
#   exit 2  --max reached and a check still reads fail/cancel (default 180s)
#
# CI_EXCLUDE_CHECKS optionally excludes explicitly non-gating checks.

set -o pipefail

PR=""; HEAD=""; MAX=180; INTERVAL=10; REPO=""
while [ $# -gt 0 ]; do
    case "$1" in
        --max) MAX="$2"; shift 2 ;;
        --interval) INTERVAL="$2"; shift 2 ;;
        --repo) REPO="$2"; shift 2 ;;
        -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
        *) if [ -z "$PR" ]; then PR="$1"; else HEAD="$1"; fi; shift ;;
    esac
done
[ -z "$PR" ] || [ -z "$HEAD" ] && { echo "usage: rerun-failed <pr> <head-sha> [--max S] [--interval S] [--repo owner/name]" >&2; exit 64; }
# shellcheck source=lib/resolve-pr-repo.sh
. "$(dirname "$(readlink -f "$0")")/lib/resolve-pr-repo.sh"
REPO=$(resolve_pr_repo rerun-failed "$PR" "$REPO") || exit 64
EXCLUDE=${CI_EXCLUDE_CHECKS:-'^$'}

failed_runs=$(gh run list --repo "$REPO" --commit "$HEAD" --json databaseId,conclusion,name --limit 30 2>/dev/null \
    | jq -r '.[] | select(.conclusion=="failure" or .conclusion=="cancelled") | .databaseId')
if [ -z "$failed_runs" ]; then echo "RERUN DONE reruns= reset=nothing-to-rerun"; exit 0; fi

reruns=()
for id in $failed_runs; do
    if gh run rerun "$id" --repo "$REPO" --failed >/dev/null 2>&1; then reruns+=("$id"); echo "rerun requested: $id"; else echo "rerun refused (already running or too old?): $id"; fi
done
ids=$(IFS=,; echo "${reruns[*]}")

start=$(date +%s)
while :; do
    still=$(gh pr checks "$PR" --repo "$REPO" --json name,bucket 2>/dev/null \
        | jq -r --arg ex "$EXCLUDE" '.[] | select(.name | test($ex) | not) | select(.bucket=="fail" or .bucket=="cancel") | .name' | paste -sd ',' -)
    if [ -z "$still" ]; then echo "RERUN DONE reruns=$ids reset=confirmed"; exit 0; fi
    if [ $(( $(date +%s) - start )) -ge "$MAX" ]; then echo "still failing: $still"; echo "RERUN DONE reruns=$ids reset=stale"; exit 2; fi
    sleep "$INTERVAL"
done
